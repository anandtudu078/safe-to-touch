# Get a free key at https://aistudio.google.com/  (put the real key in .env, never here)
GEMINI_API_KEY=

# Optional override; defaults to gemini-flash-latest (auto-follows the newest flash model)
GEMINI_MODEL=gemini-flash-latest

# Where the repo under investigation is cloned, relative to project root
TARGET_REPO_PATH=./target-repo

# Max seconds for one investigation / heatmap before the backend gives up
AGENT_TIMEOUT_SECONDS=240
GEMINI_TIMEOUT_SECONDS=60

# Frontend: where the browser finds the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
