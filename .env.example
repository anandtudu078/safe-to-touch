# Get one at https://codebuff.com/api-keys  (put the real key in .env, never here)
CODEBUFF_API_KEY=

# Where the repo under investigation is cloned, relative to project root
TARGET_REPO_PATH=./target-repo

# Max seconds for one investigation before the backend gives up
AGENT_TIMEOUT_SECONDS=240

# Frontend: where the browser finds the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
